# Shared ignore list for oxfmt and oxlint (gitignore syntax). Both tools get it
# through `--ignore-path .oxignore` in package.json; oxfmt then no longer reads
# .gitignore on its own, so build output is listed here too.
dist/
.pipeline/
test-results/
playwright-report/
.github/
README.md
CHANGELOG.md
docs/
convex/_generated/
convex/convex.config.ts
src/routeTree.gen.ts

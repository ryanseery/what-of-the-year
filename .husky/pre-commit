#!/bin/sh

# Get staged TypeScript/JSON files (oxfmt) and the TypeScript subset (oxlint —
# it exits 1 with "No files found to lint" when handed only json). Explicit
# paths bypass oxlint's --ignore-path, so .oxignore is applied here instead.
STAGED_FILES=""
for f in $(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(tsx?|json)$' || true); do
  git -c core.excludesFile=.oxignore check-ignore -q --no-index "$f" || STAGED_FILES="$STAGED_FILES $f"
done
LINT_FILES=$(echo "$STAGED_FILES" | tr ' ' '\n' | grep -E '\.tsx?$' || true)

if [ -n "$STAGED_FILES" ]; then

# Format and lint staged files

bunx oxfmt --ignore-path .oxignore --no-error-on-unmatched-pattern $STAGED_FILES
[ -n "$LINT_FILES" ] && bunx oxlint --ignore-path .oxignore --fix $LINT_FILES

# Re-add formatted files

git add $STAGED_FILES
fi

# Check TypeScript types
bun run check:types
